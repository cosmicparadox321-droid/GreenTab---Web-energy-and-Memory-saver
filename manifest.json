{
  "manifest_version": 3,
  "name": "GreenTab - Web Energy & Memory Saver",
  "version": "1.0",
  "description": "GreenTab saves web energy and memory by optimizing tab resource usage.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GreenTab - Web Energy & Memory Saver"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
